{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": { "@/*": ["./packages/ui/src/*"] }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "vitest.config.ts"],
  "exclude": ["packages/landing", "**/node_modules", "**/dist"]
}
