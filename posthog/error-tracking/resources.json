  "insights": [
    {
      "key": "sanitized-errors-by-source",
      "name": "Sanitized error reports by source",
      "description": "Manually instrumented app renderer errors. Reports are consent-dependent and deduplicated to one category/source/action per minute, capped at 20 per minute. Empty values do not mean zero errors. Messages, stacks, paths, component names and app content are excluded.",
      "preferredExistingInsightId": 6355551,
      "query": {
        "kind": "TrendsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "$exception",
            "math": "total",
            "properties": [
              {
                "key": "error_source",
                "type": "event",
                "operator": "exact",
                "value": [
                  "window_error",
                  "unhandled_rejection",
                  "react_boundary",
                  "react_uncaught",
                  "react_recoverable",
                  "api_action"
                ]
              }
            ]
          }
        ],
        "dateRange": {
          "date_from": "-30d"
        },
        "filterTestAccounts": true,
        "interval": "day",
        "breakdownFilter": {
          "breakdowns": [
            {
              "property": "error_source",
              "type": "event"
            }
          ]
        }
      }
    },
    {
