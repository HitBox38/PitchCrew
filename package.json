{
  "name": "pitchcrew",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx packages/orchestrator/src/cli.ts --dev",
    "landing:dev": "pnpm --filter @pitchcrew/landing dev",
    "landing:build": "pnpm --filter @pitchcrew/landing build",
    "landing:start": "pnpm --filter @pitchcrew/landing start",
    "desktop": "pnpm --filter @pitchcrew/desktop build && node --import tsx scripts/desktop.ts",
    "desktop:prod": "pnpm build && node --import tsx scripts/desktop.ts --production",
    "desktop:package": "pnpm build && node --import tsx scripts/prepare-desktop-release.ts && node --import tsx scripts/build-desktop-installer.ts",
    "test:packaged": "node --import tsx scripts/packaged-smoke.ts",
    "test:installer": "node --import tsx scripts/windows-installer-smoke.ts",
    "build": "pnpm --filter @pitchcrew/ui build && pnpm --filter @pitchcrew/desktop build",
    "icon:build": "pnpm --filter @pitchcrew/desktop build && node --import tsx scripts/build-icon.ts",
    "start": "node --import tsx packages/orchestrator/src/cli.ts",
    "service": "node --import tsx packages/orchestrator/src/cli.ts service",
    "test": "node --import tsx --test scripts/posthog/*.test.ts && vitest run",
    "test:desktop": "pnpm build && node --import tsx scripts/desktop-smoke.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @pitchcrew/landing typecheck",
    "lint": "oxlint --deny-warnings packages scripts vitest.config.ts && node --import tsx scripts/check-components.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm landing:build",
    "browser:install": "pnpm --filter @pitchcrew/mcp exec playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
