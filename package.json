{
  "name": "pitchcrew",
  "version": "0.15.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file --no-install packages/orchestrator/src/cli.ts --dev",
    "landing:dev": "bun run --filter @pitchcrew/landing dev",
    "landing:build": "bun run --filter @pitchcrew/landing build",
    "landing:start": "bun run --filter @pitchcrew/landing start",
    "desktop": "bun run --filter @pitchcrew/desktop build && bun --no-env-file --no-install scripts/desktop.ts",
    "desktop:prod": "bun run build && bun --no-env-file --no-install scripts/desktop.ts --production",
    "desktop:package": "bun run build && bun --no-env-file --no-install scripts/prepare-desktop-release.ts && node --import tsx scripts/build-desktop-installer.ts",
    "test:packaged": "bun --no-env-file --no-install scripts/packaged-smoke.ts",
    "test:installer": "bun --no-env-file --no-install scripts/windows-installer-smoke.ts",
    "build": "bun run --filter @pitchcrew/ui build && bun run --filter @pitchcrew/desktop build",
    "icon:build": "bun run --filter @pitchcrew/desktop build && bun --no-env-file --no-install scripts/build-icon.ts",
    "start": "bun --no-env-file --no-install packages/orchestrator/src/cli.ts",
    "service": "bun --no-env-file --no-install packages/orchestrator/src/cli.ts service",
    "mcp": "bun --no-env-file --no-install packages/orchestrator/src/cli.ts mcp",
    "test": "node --import tsx --test scripts/posthog/*.test.ts && vitest run",
    "test:desktop": "bun run build && bun --no-env-file --no-install scripts/desktop-smoke.ts && bun --no-env-file --no-install packages/desktop/test/native-browser.smoke.ts",
    "typecheck": "tsc --noEmit && bun run --filter @pitchcrew/landing typecheck",
    "lint": "oxlint --deny-warnings packages scripts vitest.config.ts && bun --no-env-file --no-install scripts/check-components.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run landing:build",
    "browser:install": "bun x --no-install --cwd packages/mcp playwright install chromium",
    "test:bun": "bun --no-env-file --no-install packages/mcp/test/fixtures/bun-runtime.ts --development"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "esbuild"
  ]
}
