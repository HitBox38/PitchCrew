{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "sortTailwindcss": {
    "stylesheet": "packages/ui/src/styles.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    ".agents/**",
    "**/dist/**",
    "**/.next/**",
    "**/next-env.d.ts",
    "**/node_modules/**",
    "pnpm-lock.yaml"
  ]
}
